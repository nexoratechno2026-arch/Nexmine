# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=nexmine
POSTGRES_PASSWORD=nexmine_secret
POSTGRES_DB=nexmine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nexmine:nexmine_secret@localhost:5432/nexmine

# ─── JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Email / SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@nexmine.io
SMTP_STARTTLS=true

# ─── App ────────────────────────────────────────────────────
APP_NAME=NexMine
FRONTEND_URL=http://localhost:5173

# ─── pgAdmin (Docker only) ───────────────────────────────────
PGADMIN_EMAIL=admin@nexmine.local
PGADMIN_PASSWORD=admin

# ─── AI Layer (Phase 6) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
